---
import MusicaFondo2 from "@/components/shared/MusicaFondo.astro";
---

<section class="relative w-full flex flex-col pb-16 bg-dark-blue-3 z-20">
  <img
    src="/assets/tema2/marco_dorado.png"
    class="absolute right-[-50%] sm:right-[-25%] top-1/4 h-[80vh] object-contain opacity-90 z-0 pointer-events-none drop-shadow-lg"
    alt="Hojas acuarela"
  />

  <div
    class="z-10 flex flex-col items-center w-full px-6 pt-20 sm:pt-28 text-center text-pastel"
  >
    <h2
      class="text-3xl sm:text-4xl font-yrsa tracking-[0.25em] text-pastel uppercase mb-10"
    >
      Estamos felices
    </h2>

    <p class="text-sm font-abeezee mb-8 max-w-70 sm:max-w-sm">
      de compartir con ustedes la alegría<br />
      de un día inolvidable para nosotros<br />
      el día de nuestra boda
    </p>

    <p
      class="text-sm font-abeezee mb-12 max-w-70 sm:max-w-sm"
    >
      ¡los invitamos a unirse a nuestra<br />
      celebración y decorar<br />
      con su presencia!
    </p>
  </div>
  <MusicaFondo2 />
</section>
